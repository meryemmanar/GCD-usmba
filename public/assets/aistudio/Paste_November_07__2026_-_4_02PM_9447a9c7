// ============================================================================
// 1. TYPAGES TYPESCRIPT CONFORMES AU SCHÉMA SUPABASE
// ============================================================================

export type ProfilRole = 
  | 'VISITEUR'
  | 'CANDIDAT'
  | 'DIRECTEUR_THESE'
  | 'DIRECTEUR_STRUCTURE'
  | 'AGENT_ADMIN'
  | 'ADMIN_ED';

export type StatutCandidature = 
  | 'BROUILLON'
  | 'SOUMISE'
  | 'EN_EXAMEN'
  | 'CORRECTION_DEMANDEE'
  | 'ACCEPTEE'
  | 'REFUSEE';

export type StatutIdentite = 'NON_VERIFIE' | 'A_EXAMINER' | 'CONFORME' | 'NON_CONFORME';

export type StatutValidationSujet = 'EN_ATTENTE' | 'VALIDE' | 'REJETE';

export interface SujetThese {
  id: string;
  titre: string;
  description: string;
  nombre_places: number;
  statut: 'PROPOSE' | 'VALIDE' | 'CLOTURE';
  propose_par: string; // Nom Encadrant
  encadrant_id: string;
  structure: string; // Laboratoire / Équipe
  etablissement: string; // FST, FS Dhar Mehraz, etc.
  annee: number;
  theme: string;
  validation_structure: StatutValidationSujet;
  validation_centre: StatutValidationSujet;
  validation_pole: StatutValidationSujet;
}

export interface DocumentCandidat {
  id: string;
  type: string;
  nom_fichier: string;
  taille_mo: number;
  date_depot: string;
  obligatoire: boolean;
  statut_verification: 'EN_ATTENTE' | 'CONFORME' | 'NON_CONFORME';
}

export interface Candidature {
  id: string;
  personne_id: string;
  version_campagne_id: string;
  candidat_nom: string;
  candidat_prenom: string;
  candidat_cne: string;
  candidat_email: string;
  date_creation: string;
  date_soumission?: string;
  statut: StatutCandidature;
  choix_sujets: { priorite: number; sujet: SujetThese }[];
  documents: DocumentCandidat[];
  motif_correction?: string;
  // Étape 1 : Directeur de Thèse
  etape1?: {
    decideur: string;
    date_convocation?: string;
    note?: number;
    resultat?: 'LISTE_PRINCIPALE' | 'LISTE_ATTENTE' | 'REJETE';
    motif_refus?: string;
  };
  // Étape 2 : Directeur de Structure
  etape2?: {
    decideur: string;
    resultat?: 'FAVORABLE' | 'DEFAVORABLE';
    motif?: string;
    date_decision?: string;
  };
}

export interface VersionCampagne {
  id: string;
  campagne_id: string;
  annee_universitaire: string;
  date_ouverture: string;
  date_cloture: string;
  date_modification: string;
  motif_modification: string;
  modifie_par: string;
  statut: 'OUVERTE' | 'CLOTUREE';
}

export interface PersonneIdentite {
  id: string;
  nom: string;
  prenom: string;
  email: string;
  telephone: string;
  date_naissance: string;
  lieu_naissance: string;
  pays: string;
  type_document_identite: 'CIN' | 'PASSEPORT' | 'SEJOUR';
  numero_document_identite: string;
  cne: string;
  statut_identite: StatutIdentite;
  motif_identite?: string;
  scan_url: string;
}

